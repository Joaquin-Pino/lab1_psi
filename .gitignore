.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Datos (el enunciado exige NO versionarlos) ---
data/
datos/
datasets/
fma_small/
fma_metadata/
*.mp3
*.wav
*.flac
*.ogg
*.npy
*.npz
*.pkl
*.pickle
