# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Entornos virtuales ---
.venv/
venv/
env/
ENV/

# --- Empaquetado / instalación (pip install -e .) ---
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

